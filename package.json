{
  "name": "tracelens",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @leracherry/tracelens-studio --filter @leracherry/tracelens-playground dev",
    "pretest": "pnpm --filter @leracherry/tracelens-core build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:capture": "pnpm build && node scripts/capture-readme.mjs",
    "docs:demo": "pnpm build && node scripts/capture-readme.mjs --animate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@leracherry/tracelens-cli": "workspace:*",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4"
  }
}
