    "@leracherry/tracelens-vite": "workspace:*",
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
